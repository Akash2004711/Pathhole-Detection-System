# ==========================================================================
# Pothole Detection System - Backend environment variables (TEMPLATE)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---- Application ----
APP_ENV=development
# Public base URL of the backend/API (used in email links, CORS, etc.)
APP_BASE_URL=http://127.0.0.1:8000
# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5500,http://localhost:3000

# ---- AI / YOLO model ----
# Absolute or backend-relative path to trained YOLO weights (.pt).
# If the file is missing, the API returns a clear, actionable error
# instead of fabricated detections.
YOLO_MODEL_PATH=models/pothole_yolov8.pt
# Comma-separated class-name keywords treated as potholes. Detections whose
# class does not match are ignored, so non-pothole objects (e.g. cars from a
# COCO model) are never reported. Leave empty to accept every class.
POTHOLE_CLASS_NAMES=pothole
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
# Video frame sampling: run inference every Nth frame (1 = every frame).
VIDEO_FRAME_SAMPLE_STRIDE=5
# Limit how many frames are processed per video request.
VIDEO_MAX_FRAMES=600

# ---- Upload limits ----
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=120

# ---- Firebase ----
# Firebase project ID (from the Firebase console).
FIREBASE_PROJECT_ID=
# Path to the service-account JSON used by the Firebase Admin SDK.
# Keep this file OUT of version control.
FIREBASE_CREDENTIALS_PATH=service-account.json
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to the same file.
GOOGLE_APPLICATION_CREDENTIALS=
# Web Firebase config for the frontend (public values, safe to expose).
# Used by frontend/firebase-config.js via a runtime config file.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Registration ----
# Shared secret required to register as a Government Authority from the app.
# Leave empty to disable authority self-registration (citizens only).
AUTHORITY_SIGNUP_CODE=

# ---- Google Maps ----
# Frontend Maps JavaScript API key (visible in the browser; restrict it
# by HTTP referrer + API in Google Cloud Console).
GOOGLE_MAPS_API_KEY=

# ---- Email / SMTP notifications ----
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
# Authority inbox that receives new-report alerts.
AUTHORITY_ALERT_EMAIL=
# Use STARTTLS (true) or SSL (EMAIL_USE_SSL).
EMAIL_USE_TLS=true
